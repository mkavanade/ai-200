# STAGE 1: Build environment
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# GOOD: Copy ONLY the project file first
COPY ["Hello.csproj", "./"]

# GOOD: Restore dependencies in their own cacheable layer
RUN dotnet restore "Hello.csproj"

# GOOD: Now copy the rest of the source code (Program.cs)
COPY . .

# GOOD: Publish using the cached restored packages
RUN dotnet publish "Hello.csproj" -c Release -o /app/publish --no-restore

# STAGE 2: Runtime environment
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app

EXPOSE 8080

# GOOD: Run as a non-root user for production security (Built into .NET 8 images)
USER $APP_UID

# GOOD: Copy only the final compiled binaries from the build stage
COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "Hello.dll"]