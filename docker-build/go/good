# STAGE 1: Build environment
FROM golang:1.21-alpine AS build
WORKDIR /src

# GOOD: Copy ONLY the module file first
COPY app/go.mod ./

# GOOD: Download dependencies in their own cacheable layer
RUN go mod download

# GOOD: Now copy the rest of the source code
COPY app/ .

# GOOD: Static build using the cached, downloaded modules
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/server http-server.go

# STAGE 2: Runtime environment
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app

EXPOSE 8090

# GOOD: Run as a non-root user for production security (built into distroless)
USER nonroot:nonroot

# GOOD: Copy only the final compiled binary from the build stage
COPY --from=build /app/server .

CMD ["./server"]
